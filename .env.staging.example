# CloudCampus staging environment template.
# Copy to a server-side .env.staging file or secret store. Do not commit real secrets.

SPRING_PROFILES_ACTIVE=staging

CLOUDCAMPUS_DB_NAME=cloudcampus
CLOUDCAMPUS_DB_USERNAME=cloudcampus
CLOUDCAMPUS_DB_PASSWORD=replace-with-staging-db-password
CLOUDCAMPUS_POSTGRES_PORT=15432

CLOUDCAMPUS_JDBC_URL=jdbc:postgresql://postgres:5432/cloudcampus
CLOUDCAMPUS_JDBC_DRIVER=org.postgresql.Driver
CLOUDCAMPUS_JDBC_USERNAME=cloudcampus
CLOUDCAMPUS_JDBC_PASSWORD=replace-with-staging-db-password

CLOUDCAMPUS_AUTH_JWT_SECRET=replace-with-staging-64-byte-random-secret
CLOUDCAMPUS_EMAIL_MODE=log
CLOUDCAMPUS_EMAIL_FROM=no-reply@staging.cloudcampus.example
CLOUDCAMPUS_APP_BASE_URL=https://staging.cloudcampus.example
CLOUDCAMPUS_FRONTEND_ORIGIN=https://staging.cloudcampus.example
CLOUDCAMPUS_CORS_ALLOWED_ORIGINS=https://staging.cloudcampus.example

CLOUDCAMPUS_SMTP_HOST=
CLOUDCAMPUS_SMTP_PORT=587
CLOUDCAMPUS_SMTP_USERNAME=
CLOUDCAMPUS_SMTP_PASSWORD=
CLOUDCAMPUS_SMTP_AUTH=true
CLOUDCAMPUS_SMTP_STARTTLS=true
CLOUDCAMPUS_ALLOW_LOG_EMAIL_IN_PRODUCTION=true

CLOUDCAMPUS_BOOTSTRAP_SUPER_ADMIN_ENABLED=false
CLOUDCAMPUS_BOOTSTRAP_SUPER_ADMIN_EMAIL=
CLOUDCAMPUS_BOOTSTRAP_SUPER_ADMIN_PASSWORD=
CLOUDCAMPUS_BOOTSTRAP_SUPER_ADMIN_DISPLAY_NAME=CloudCampus Super Admin

CLOUDCAMPUS_BACKEND_PORT=18080
CLOUDCAMPUS_FRONTEND_PORT=18088
CLOUDCAMPUS_BACKEND_IMAGE=ghcr.io/your-org/cloudcampus/backend:staging
CLOUDCAMPUS_FRONTEND_IMAGE=ghcr.io/your-org/cloudcampus/frontend:staging

# Optional. Leave blank for same-origin Nginx proxy deployment.
# Set to https://api.staging.cloudcampus.example only for split frontend/backend hosting.
VITE_API_BASE_URL=
