# CloudCampus production environment template.
# Store real values in a secret manager or server-only .env.production file.
# Never commit real production values.

SPRING_PROFILES_ACTIVE=prod

CLOUDCAMPUS_DB_NAME=cloudcampus
CLOUDCAMPUS_DB_USERNAME=cloudcampus
CLOUDCAMPUS_DB_PASSWORD=replace-with-production-db-password

# Prefer RDS PostgreSQL in production. For EC2 MVP embedded PostgreSQL, keep host as postgres.
CLOUDCAMPUS_JDBC_URL=jdbc:postgresql://postgres:5432/cloudcampus
CLOUDCAMPUS_JDBC_DRIVER=org.postgresql.Driver
CLOUDCAMPUS_JDBC_USERNAME=cloudcampus
CLOUDCAMPUS_JDBC_PASSWORD=replace-with-production-db-password

CLOUDCAMPUS_AUTH_JWT_SECRET=replace-with-production-64-byte-random-secret
CLOUDCAMPUS_EMAIL_MODE=smtp
CLOUDCAMPUS_EMAIL_FROM=no-reply@cloudcampus.example
CLOUDCAMPUS_APP_BASE_URL=https://api.cloudcampus.example
CLOUDCAMPUS_CORS_ALLOWED_ORIGINS=https://api.cloudcampus.example
CLOUDCAMPUS_AI_ENABLED=false
CLOUDCAMPUS_AI_PROVIDER=mock
CLOUDCAMPUS_AI_MODEL=mock-school-helper
CLOUDCAMPUS_AI_API_KEY=

CLOUDCAMPUS_SMTP_HOST=smtp.example.com
CLOUDCAMPUS_SMTP_PORT=587
CLOUDCAMPUS_SMTP_USERNAME=replace-with-smtp-username
CLOUDCAMPUS_SMTP_PASSWORD=replace-with-smtp-password
CLOUDCAMPUS_SMTP_AUTH=true
CLOUDCAMPUS_SMTP_STARTTLS=true
CLOUDCAMPUS_ALLOW_LOG_EMAIL_IN_PRODUCTION=false

# Production bootstrap must stay disabled.
CLOUDCAMPUS_BOOTSTRAP_SUPER_ADMIN_ENABLED=false
CLOUDCAMPUS_BOOTSTRAP_SUPER_ADMIN_EMAIL=
CLOUDCAMPUS_BOOTSTRAP_SUPER_ADMIN_PASSWORD=
CLOUDCAMPUS_BOOTSTRAP_SUPER_ADMIN_DISPLAY_NAME=CloudCampus Super Admin

CLOUDCAMPUS_BACKEND_PORT=18080
CLOUDCAMPUS_BACKEND_IMAGE=ghcr.io/your-org/cloudcampus/backend:prod
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
