# CloudCampus local development environment template.
# Copy to .env for local Docker Compose use only. Do not commit real secrets.
# LOCAL ONLY: values in this file are intentionally convenient placeholders.
# Never copy local passwords, local JWT secrets, or bootstrap credentials into staging/production.

SPRING_PROFILES_ACTIVE=local

CLOUDCAMPUS_DB_NAME=cloudcampus
CLOUDCAMPUS_DB_USERNAME=cloudcampus
CLOUDCAMPUS_DB_PASSWORD=cloudcampus_local_password
CLOUDCAMPUS_POSTGRES_PORT=15432

CLOUDCAMPUS_JDBC_URL=jdbc:postgresql://postgres:5432/cloudcampus
CLOUDCAMPUS_JDBC_DRIVER=org.postgresql.Driver
CLOUDCAMPUS_JDBC_USERNAME=cloudcampus
CLOUDCAMPUS_JDBC_PASSWORD=cloudcampus_local_password

CLOUDCAMPUS_AUTH_JWT_SECRET=local-only-change-me-cloudcampus-auth-token-secret-64-bytes
CLOUDCAMPUS_EMAIL_MODE=log
CLOUDCAMPUS_EMAIL_FROM=no-reply@cloudcampus.local
CLOUDCAMPUS_APP_BASE_URL=http://localhost:18080
CLOUDCAMPUS_CORS_ALLOWED_ORIGINS=http://localhost:18080,http://127.0.0.1:18080

CLOUDCAMPUS_SMTP_HOST=
CLOUDCAMPUS_SMTP_PORT=587
CLOUDCAMPUS_SMTP_USERNAME=
CLOUDCAMPUS_SMTP_PASSWORD=
CLOUDCAMPUS_SMTP_AUTH=true
CLOUDCAMPUS_SMTP_STARTTLS=true
CLOUDCAMPUS_ALLOW_LOG_EMAIL_IN_PRODUCTION=false

# LOCAL ONLY bootstrap account for developer machines.
# Shared staging and production must keep bootstrap disabled and use controlled account creation.
CLOUDCAMPUS_BOOTSTRAP_SUPER_ADMIN_ENABLED=true
CLOUDCAMPUS_BOOTSTRAP_SUPER_ADMIN_EMAIL=superadmin@cloudcampus.dev
CLOUDCAMPUS_BOOTSTRAP_SUPER_ADMIN_PASSWORD=SuperAdmin123!
CLOUDCAMPUS_BOOTSTRAP_SUPER_ADMIN_DISPLAY_NAME=CloudCampus Super Admin

CLOUDCAMPUS_BACKEND_PORT=18080
CLOUDCAMPUS_BACKEND_IMAGE=cloudcampus-backend:local
