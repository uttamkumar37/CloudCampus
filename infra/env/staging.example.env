# Copy this file outside the repository and inject real values through the deployment platform.
# Do not commit production secrets.

CLOUDCAMPUS_JDBC_URL=jdbc:h2:mem:cloudcampus;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH
CLOUDCAMPUS_JDBC_DRIVER=org.h2.Driver
CLOUDCAMPUS_JDBC_USERNAME=sa
CLOUDCAMPUS_JDBC_PASSWORD=

CLOUDCAMPUS_EMAIL_MODE=log
CLOUDCAMPUS_EMAIL_FROM=no-reply@cloudcampus.local
CLOUDCAMPUS_APP_BASE_URL=http://localhost:8088
CLOUDCAMPUS_SMTP_HOST=
CLOUDCAMPUS_SMTP_PORT=587
CLOUDCAMPUS_SMTP_USERNAME=
CLOUDCAMPUS_SMTP_PASSWORD=
CLOUDCAMPUS_SMTP_AUTH=true
CLOUDCAMPUS_SMTP_STARTTLS=true

# Local-only bootstrap. Keep disabled in shared staging unless explicitly rotated.
CLOUDCAMPUS_BOOTSTRAP_SUPER_ADMIN_ENABLED=false
CLOUDCAMPUS_BOOTSTRAP_SUPER_ADMIN_EMAIL=
CLOUDCAMPUS_BOOTSTRAP_SUPER_ADMIN_PASSWORD=
